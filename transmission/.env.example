# User and group ID of the host user — files written to volumes will be owned by this UID/GID
PUID=1000
PGID=1000

# WebUI port exposed on the host
WEBUI_PORT=9091

# BitTorrent peer port (TCP + UDP)
PEER_PORT=51413

# Transmission WebUI credentials — set before first start;
# after first start these are persisted in the config volume
TRANSMISSION_USERNAME=admin
TRANSMISSION_PASSWORD=changeme

# Host paths for persistent storage (can be absolute or relative)
DOWNLOADS_PATH=./data/downloads
CONFIG_PATH=./data/config
